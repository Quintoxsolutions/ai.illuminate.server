# Firebase Configuration
# IMPORTANT: Replace with your actual Firebase service account credentials.
# You can get this from your Firebase project settings -> Service accounts -> Generate new private key.
# It should be a JSON string.
# Example: FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "your-project-id", ...}'
# Alternatively, you can provide a path to the service account JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH='./path/to/your/serviceAccountKey.json'
FIREBASE_SERVICE_ACCOUNT=

# Firebase Realtime Database URL
# Example: FIREBASE_DATABASE_URL='https://your-project-id-default-rtdb.firebaseio.com'
FIREBASE_DATABASE_URL=

# Server Port
PORT=8080

# Allowed Client Origins for CORS and Socket.IO
# Comma-separated list of URLs where your frontend application is hosted.
# Example: CLIENT_ORIGINS='http://localhost:3000,https://your-frontend-domain.com'
CLIENT_ORIGINS='http://localhost:3000'
